# Set environment variables
export GEOMESA_DYNAMODB_HOME="${GEOMESA_DYNAMODB_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"
export PATH="${GEOMESA_DYNAMODB_HOME}/bin:$PATH"

# Check for required environment variables
if [[ -z "${AWS_REGION}" && -z "${AWS_DEFAULT_REGION}" ]]; then
    echo "Warning: AWS_REGION or AWS_DEFAULT_REGION environment variable not set"
fi

# Set up classpath
if [[ -n "$GEOMESA_DYNAMODB_CLASSPATH" ]]; then
    CLASSPATH="$GEOMESA_DYNAMODB_CLASSPATH"
else
    CLASSPATH="$GEOMESA_DYNAMODB_HOME/lib/*"
fi

# Set JVM options
JAVA_OPTS="${JAVA_OPTS} -Xmx2g"
JAVA_OPTS="${JAVA_OPTS} -Duser.timezone=UTC"
JAVA_OPTS="${JAVA_OPTS} -Djava.awt.headless=true"

# Add AWS SDK system properties if needed
if [[ -n "${AWS_PROFILE}" ]]; then
    JAVA_OPTS="${JAVA_OPTS} -Daws.profile=${AWS_PROFILE}"
fi

if [[ -n "${AWS_REGION}" ]]; then
    JAVA_OPTS="${JAVA_OPTS} -Daws.region=${AWS_REGION}"
elif [[ -n "${AWS_DEFAULT_REGION}" ]]; then
    JAVA_OPTS="${JAVA_OPTS} -Daws.region=${AWS_DEFAULT_REGION}"
fi

# Run the command
exec java ${JAVA_OPTS} -cp "${CLASSPATH}" org.locationtech.geomesa.dynamodb.tools.DynamoDbRunner "$@"
